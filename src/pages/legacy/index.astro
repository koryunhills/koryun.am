---
import WebflowLayout from '../../layouts/WebflowLayout.astro';
import WebflowContactForm from '../../components/WebflowContactForm.astro';

const animUp100 = 'transform:translate3d(0, 100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
const animUp105 = 'transform:translate3d(0, 105%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
const animUp110 = 'transform:translate3d(0, 110%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
const animUp120 = 'transform:translate3d(0, 120%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
const animUp126 = 'transform:translate3d(0, 126%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
const animUp200 = 'transform:translate3d(0, 200%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0';
---

<WebflowLayout
  title="Koryun | UX/UI Design Agency, Web Design & Branding"
  description="Koryun is a UI/UX design and branding agency. We create digital products, websites, design systems, and brand experiences."
>
  <div class="hero-section">
    <div class="div-block-12">
      <div class="hero-image-container w-container">
        <div class="div-block-76">
          <h1 data-w-id="2afdadca-c1b9-eab4-2d3f-2c0bb0dab50f" style={animUp100} class="hero-1-line hero-title-text">Elevating</h1>
        </div>
        <div class="div-block-77">
          <h1 data-w-id="6aad94c3-5178-1661-bb60-ea8785b215c8" style={animUp100} class="hero-2-line hero-title-text">user experience</h1>
        </div>
        <div class="div-block-78">
          <h1 data-w-id="e7b9b5dd-c964-ecf2-f53b-ca1e22a68ce9" style={animUp100} class="hero-3-line hero-title-text">to new heights</h1>
        </div>
        <div class="above-line-div">
          <p data-w-id="55ed3ecf-9346-f390-b8cc-6d256b630225" style={animUp100} class="hero-paragraph">UX agency</p>
        </div>
        <div data-w-id="65f6ada5-500a-2241-1746-f67f04c50d35" style="transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(90deg) rotateZ(0) skew(0, 0);transform-style:preserve-3d;opacity:0" class="hero-section-divider"></div>
        <div class="under-line-div">
          <div class="w-layout-grid grid-7">
            <div class="div-block-79">
              <p data-w-id="5dabe902-4fd8-41f8-2313-f3803ef5741b" style={animUp105} class="text">We're a UX agency that designs beautiful user interfaces & experiences.</p>
            </div>
            <div class="div-block-56">
              <a href="#Contact-us" data-w-id="44e310b9-9d42-1a23-d170-52f029ab8d21" style={animUp120} class="start-a-project w-inline-block">
                <div class="text-block-7-copy">Start a project</div>
                <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63e499ce2ac61a17a098795c_east.svg" loading="lazy" alt="An Arrow Icon to the east" class="arrow" />
                <div class="div-block-94"></div>
              </a>
            </div>
            <div class="mobile-sp">
              <a href="#Contact-us" data-w-id="89b62da5-9017-1ef8-f854-478aa131b746" style={animUp120} class="sp-mobile-2 w-inline-block">
                <div class="text-block-7-copy">Start a project</div>
                <div class="div-block-94">
                  <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63e499ce2ac61a17a098795c_east.svg" loading="lazy" alt="An Arrow Icon to the east" class="arrow" />
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="blur-bg">
        <div class="main-shapes-wrapper">
          <div class="_10"></div>
          <div class="shape-9"></div>
          <div class="shape-1"></div>
          <div class="shape-3"></div>
          <div class="shape-2"></div>
        </div>
        <div class="blending-group-wrapper">
          <div class="shape-8"></div>
          <div class="shape-4"></div>
          <div class="shape-7"></div>
          <div class="shape-5"></div>
          <div class="shape-6"></div>
        </div>
        <div class="logo-bg"></div>
        <div class="background-noise"></div>
      </div>
    </div>
  </div>

  <div data-w-id="6afc54f2-1816-ea40-0194-d94e1eaaacc0" class="work-section">
    <div class="works-container w-container">
      <div class="div-block-80">
        <h2 style={animUp126} class="work-heading">Work</h2>
      </div>
      <div class="div-block-81">
        <p style={animUp126} class="subhead-work">Our team experts help people like you craft beautifully simple and world-class products.</p>
      </div>
      <div style={animUp126} class="project-div goutier _1">
        <div class="project-type">
          <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8f076198c40ead251d415_Eye.svg" loading="lazy" alt="" class="image-6" />
          <div class="text-block-3">Product design</div>
        </div>
        <a href="/gouter" data-w-id="a3ec8910-fe15-e196-5cbe-a5956e560989" class="see-case-study-button-copy w-inline-block">
          <div class="div-block-96">
            <div class="div-block-95">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy" />
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy-copy" />
            </div>
          </div>
          <div class="text-block-2-copy">See case study</div>
        </a>
      </div>
      <div data-w-id="7affa17f-43f1-1e95-8632-25f585d6e857" class="div-block-88">
        <div data-w-id="491f2a14-08ff-d0c9-5c46-f2a8c1da093e" style={animUp120} class="project-name">Gouter</div>
      </div>
      <div class="div-block-89">
        <div data-w-id="b33cf5e9-76b8-93e8-0c26-96c6baf0512f" style={animUp120} class="project-description">Gouter is a modern, simple to use Online QR-code Menu that allows customers to browse digital menu using their mobile devices. It gives possibility to guests not only to dine-in, but also reserve a table and make a pre-order.</div>
        <div data-w-id="170c134f-56a9-a406-78b9-a680b4fb7286" style={animUp120} class="project-tags-div">
          <div class="tag">User flows and prototypes</div>
          <div class="tag">UI and interaction design</div>
          <div class="tag">Branding and Visual identity</div>
        </div>
      </div>
      <div data-w-id="0cd8af1e-54f6-07d8-3f88-ffe5791e4c20" class="div-trigger-project-blocks"></div>
      <div class="w-layout-grid other-projects">
        <div class="naviguide-grid">
          <div style={animUp120} class="naviguide-cover-image naviguide">
            <div class="project-type">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8f076198c40ead251d415_Eye.svg" loading="lazy" alt="" class="image-6" />
              <div class="text-block-3">Product design</div>
            </div>
            <a href="/naviguide" data-w-id="38e8b2c1-fba3-cdf0-810c-93fa52cced2a" class="see-case-study-button-copy w-inline-block">
              <div class="div-block-96">
                <div class="div-block-95">
                  <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy" />
                  <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy-copy" />
                </div>
              </div>
              <div class="text-block-2-copy">See case study</div>
            </a>
          </div>
          <div class="div-block-90">
            <div style={animUp120} class="naviguide-project-name">Naviguide</div>
          </div>
          <div class="div-block-92">
            <div style={animUp200} class="naviguide-project-description">Naviguide is the mobile application for outdoor and indoor navigation with real-time positioning system of stadium. The solutions will help the user to enable indoor spatial data management, digitizing venues, and building best-in-class indoor mapping experiences for all visitors.</div>
            <div style={animUp110} class="project-tags-naviguide">
              <div class="tag navi">User flows and prototypes</div>
              <div class="tag navi">UI and interaction design</div>
              <div class="tag navi">Branding and Visual identity</div>
              <div class="tag navi">In-depth user research</div>
              <div class="tag navi">Market and data analysis</div>
            </div>
          </div>
        </div>
        <div class="torn-grid">
          <div style={animUp120} class="torn-cover-image-container torn">
            <div class="project-type">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8f076198c40ead251d415_Eye.svg" loading="lazy" alt="" class="image-6" />
              <div class="text-block-3">Product design</div>
            </div>
            <a href="/torn" data-w-id="69abe2eb-6698-caf6-98e3-a8b290801971" class="see-case-study-button-copy w-inline-block">
              <div class="div-block-96">
                <div class="div-block-95">
                  <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy" />
                  <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e895f4ed4954ae18db34_Arrow%20up.svg" loading="lazy" alt="" class="image-5-copy-copy-copy" />
                </div>
              </div>
              <div class="text-block-2-copy">See case study</div>
            </a>
          </div>
          <div class="torn-project-name-div">
            <div style={animUp120} class="torn-project-name">Torn</div>
          </div>
          <div class="div-block-93">
            <div style={animUp200} class="torn-project-description">Torn is the timeshare brand of Vidar & Co. construction group. The vision of the company is to revolutionize the holiday and share vacation ownership industry by bringing world class holiday experiences to middle class families in affordable prices.</div>
            <div style={animUp120} class="torn-project-tags">
              <div class="tag torn">User flows and prototypes</div>
              <div class="tag torn">UI and interaction design</div>
              <div class="tag torn">Roadmapping and planning</div>
              <div class="tag torn">Scalable design system</div>
              <div class="tag torn">Market and data analysis</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div data-w-id="6ec89f9b-8e1b-2bae-a4b7-7a854218797d" class="services-section-home">
    <div class="services-container-home w-container">
      <div>
        <div style={animUp120} class="section-heading">Services</div>
      </div>
      <div>
        <div style={animUp120} class="section-paragraph">Creating a strong strategy and implementing it through creative design capabilities.</div>
      </div>
      <div class="w-layout-grid services-grid">
        <div style={animUp120} class="card-1">
          <div class="icon-service">
            <div class="icon-service _1">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e81f064c5a6cd7a50aaa_telescope.svg" loading="lazy" alt="" />
            </div>
          </div>
          <div class="service-name-card">Discovery and exploration</div>
          <div class="service-type-card">Workshops and ideation</div>
          <div class="service-type-card _2">In-depth user research</div>
          <div class="service-type-card _2">Market and data analysis</div>
        </div>
        <div style={animUp120} class="card-2">
          <div class="icon-service">
            <div class="icon-service _1">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e81f198c4000c55167c4_dataflow-03.svg" loading="lazy" alt="" />
            </div>
          </div>
          <div class="service-name-card">UX and product design</div>
          <div>
            <div class="service-type-card">User flows and prototypes</div>
            <div class="service-type-card _2">Scalable design systems</div>
            <div class="service-type-card _2">UI and interaction design</div>
            <div class="service-type-card _2">User testing</div>
          </div>
        </div>
        <div style={animUp120} class="card-3">
          <div class="icon-service">
            <div class="icon-service _1">
              <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63c8e81f09d76dce8130acf6_route.svg" loading="lazy" alt="" />
            </div>
          </div>
          <div class="service-name-card">Strategy and consultancy</div>
          <div>
            <div class="service-type-card">Product vision</div>
            <div class="service-type-card _2">Team upskilling</div>
            <div class="service-type-card _2">Process optimization</div>
            <div class="service-type-card _2">Roadmapping and planning</div>
          </div>
        </div>
      </div>
      <a href="/services" data-w-id="f3ed92f7-519a-cd3e-c2f1-2e5e9492d01f" style={animUp120} class="go-to-services-new w-inline-block">
        <div class="text-block-7-copy">Go to services</div>
        <img src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/63e499ce2ac61a17a098795c_east.svg" loading="lazy" alt="An arrow icon to the east" class="arrow" />
        <div class="div-block-94-copy"></div>
      </a>
    </div>
  </div>

  <WebflowContactForm />
</WebflowLayout>
