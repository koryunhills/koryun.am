---
import '@fontsource/geist-sans/300.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import WebflowFooter from '../components/WebflowFooter.astro';
import { CDN, WEBFLOW_CSS } from '../data/cdn';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  wfPageId?: string;
}
const { title, description = 'Koryun is a UI/UX design and branding agency. We create digital products, websites, design systems, and brand experiences.', bodyClass = 'body body-3', wfPageId = '621b68aa86678f275552a8d7' } = Astro.props;
---

<!doctype html>
<html lang="en" data-wf-domain="www.koryun.am" data-wf-page={wfPageId} data-wf-site="621b68aa86678f4b4952a8d6">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${CDN}/63e4e5e3e8518d94f6194e18_Frame%201204.jpg`} />
  <meta property="og:type" content="website" />
  <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link rel="stylesheet" href={WEBFLOW_CSS} type="text/css" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <style is:global>
    /* Geist over Webflow SF / Arial; keep Webflow icon font */
    html body,
    html body * {
      font-family: 'Geist Sans', ui-sans-serif, system-ui, sans-serif !important;
    }
  </style>
  <style>
    ::selection { color: #ffffff; background: #E22D43; }
  </style>
</head>
<body class={bodyClass}>
  <div class="div-block-57">
    <!-- Mobile header -->
    <div class="men mobile">
      <div data-w-id="3a519273-fcda-d3d5-3494-beabb0690fc3" class="div-block-36">
        <a href="/" class:list={['link-block-3', 'w-inline-block', Astro.url.pathname === '/' && 'w--current']} aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
          <img src={`${CDN}/63ca7a6044dbbf3a3ef4217f_Logo.svg`} loading="lazy" data-w-id="3a519273-fcda-d3d5-3494-beabb0690fc5" alt="koryun logo" class="image-27" />
          <img src={`${CDN}/63da70e20c7389a154ba8ebd_Group%201290.svg`} loading="lazy" data-w-id="3a519273-fcda-d3d5-3494-beabb0690fc6" alt="" class="image-21" />
        </a>
        <a href="#" class="menu w-inline-block">
          <div id="menu" buttom="buttom" data-w-id="3a519273-fcda-d3d5-3494-beabb0690fc8" class="hamburger">
            <div data-w-id="3a519273-fcda-d3d5-3494-beabb0690fc9" class="burger-line-1"></div>
            <div data-w-id="3a519273-fcda-d3d5-3494-beabb0690fca" class="burger-line-2"></div>
            <div data-w-id="3a519273-fcda-d3d5-3494-beabb0690fcb" class="burger-line-3"></div>
          </div>
          <div data-w-id="3a519273-fcda-d3d5-3494-beabb0690fcc" class="circle menu-div"></div>
          <div class="invisible"></div>
          <div class="invisible-2"></div>
        </a>
      </div>
    </div>
    <!-- Menu overlay -->
    <div data-w-id="330c26cf-4054-1894-ee54-0cec1288ee45" class="menu-itmes" id="menu-items">
      <div class="menu-container w-container">
        <div class="w-layout-grid menu-mobile">
          <div id="w-node-_330c26cf-4054-1894-ee54-0cec1288ee48-1288ee43" class="us">
            <a href="/services" class="us-link-menu-mobile">Services</a>
            <a href="/about" class="us-link-menu-mobile">About us</a>
            <div class="social-media-div">
              <a href="mailto:sunday@koryun.am?subject=Let's%20work%20together!" class="social-link-mobile w-inline-block">
                <img src={`${CDN}/63c94f3d0b8ae885819eceb7_Group%20693.svg`} loading="lazy" alt="email icon" />
              </a>
              <a href="https://www.behance.net/koryunteam" target="_blank" rel="noopener" class="social-link-mobile w-inline-block">
                <img src={`${CDN}/63c94f3c9711211ccc978767_Group%20691.svg`} loading="lazy" alt="Behance icon" />
              </a>
              <a href="https://dribbble.com/koryunam/shots" target="_blank" rel="noopener" class="social-link-mobile w-inline-block">
                <img src={`${CDN}/63c94f3d3452e658135c5c28_Group%20692.svg`} loading="lazy" alt="dribbble icon" />
              </a>
              <a href="https://www.linkedin.com/company/koryun/" target="_blank" rel="noopener" class="social-link-mobile w-inline-block">
                <img src={`${CDN}/63dbd0c9557d475d6506f8fb_Group%20691.svg`} loading="lazy" alt="LinkedIn" />
              </a>
            </div>
          </div>
          <div id="w-node-_330c26cf-4054-1894-ee54-0cec1288ee56-1288ee43" class="case-studies">
            <div class="casee-study-headline-mobile">Case studies</div>
            <a href="/naviguide" class="link-mobile">Naviguide</a>
            <a href="/gouter" class="link-mobile">Gouter</a>
            <a href="/torn" class="link-mobile">Torn</a>
          </div>
        </div>
        <div class="w-layout-grid grid-13">
          <div id="w-node-_330c26cf-4054-1894-ee54-0cec1288ee60-1288ee43" class="case-studies">
            <div class="case-studies-div">
              <div class="text-block-35">Case studies</div>
            </div>
            <div class="naviguide-div">
              <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee63" href="/naviguide" class="link-menu-naviguide">Naviguide</a>
            </div>
            <div class="goutier-div">
              <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee65" href="/gouter" class="link-menu-naviguide _1">Gouter</a>
            </div>
            <div class="torn-div">
              <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee67" href="/torn" class="link-menu-naviguide _2">Torn</a>
            </div>
          </div>
          <div id="w-node-_330c26cf-4054-1894-ee54-0cec1288ee69-1288ee43" class="us">
            <div class="services-div w-clearfix">
              <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee6a" href="/services" class="us-link-menu _1">Services</a>
            </div>
            <div class="about-div">
              <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee6c" href="/about" class="us-link-menu">About us</a>
            </div>
            <div class="social-media-div">
              <div class="social-media-div-wrapper">
                <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee71" href="mailto:sunday@koryun.am?subject=Let's%20work%20together!" class="social-link w-inline-block">
                  <img src={`${CDN}/63c94f3d0b8ae885819eceb7_Group%20693.svg`} loading="lazy" alt="email icon" />
                </a>
                <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee73" href="https://www.behance.net/koryunteam" target="_blank" rel="noopener" class="link-block-5 w-inline-block">
                  <img src={`${CDN}/63c94f3c9711211ccc978767_Group%20691.svg`} loading="lazy" alt="Behance icon" class="image-behance-link" />
                </a>
                <a data-w-id="330c26cf-4054-1894-ee54-0cec1288ee75" href="https://dribbble.com/koryunam/shots" target="_blank" rel="noopener" class="link-block-4 w-inline-block">
                  <img src={`${CDN}/63c94f3d3452e658135c5c28_Group%20692.svg`} loading="lazy" alt="dribbble icon" class="image-link-dribbble _3" />
                </a>
                <a data-w-id="747ce9cc-91ae-119e-1357-a122280e55da" href="https://www.linkedin.com/company/koryun/" target="_blank" rel="noopener" class="link-block-6 w-inline-block">
                  <img src={`${CDN}/63dbd0c9557d475d6506f8fb_Group%20691.svg`} loading="lazy" alt="LinkedIn" class="image-link-linkedin _3" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <slot />

  <WebflowFooter />

  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=621b68aa86678f4b4952a8d6" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/js/webflow.schunk.36b8fb49256177c8.js" type="text/javascript"></script>
  <script src="https://cdn.prod.website-files.com/621b68aa86678f4b4952a8d6/js/webflow.c0e75bb7.6f7406f5ea7ab60f.js" type="text/javascript"></script>
</body>
</html>
