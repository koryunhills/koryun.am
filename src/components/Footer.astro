<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-main">
      <a href="/" class="footer-logo">koryun</a>
      <nav class="footer-nav">
        <a href="/services">Services</a>
        <a href="/about">About us</a>
      </nav>
    </div>
    <p class="footer-copy">©2025 Koryun</p>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--section-padding);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }

  .footer-nav {
    display: flex;
    gap: 2rem;
  }

  .footer-nav a {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
