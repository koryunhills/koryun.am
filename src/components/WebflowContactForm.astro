---
import { CDN } from '../data/cdn';
---

<div id="Contact-us" data-w-id="f99b3f3e-f4d3-b005-9499-ac2fde9559b7" class="contatc-us">
  <div class="contact-us-container w-container">
    <div class="contact-us-header-div">
      <div data-w-id="f99b3f3e-f4d3-b005-9499-ac2fde9559b9" class="section-heading-contact-us white-text">Have a project in mind?</div>
    </div>
    <div class="contact-us-paragraph-div">
      <div data-w-id="f99b3f3e-f4d3-b005-9499-ac2fde9559bb" class="section-paragraph-contact-us white-text">Do you have a project or a brief about your next big thing? We will be delighted to hear from you.</div>
    </div>
    <div class="input-block tablet _1">
      <div class="input-side">
        <div class="inputs-form w-form">
          <form id="email-form" name="email-form" data-name="Email Form" method="get" class="form" data-wf-page-id="621b68aa86678f275552a8d7" data-wf-element-id="f99b3f3e-f4d3-b005-9499-ac2fde9559c0">
            <div class="w-layout-grid grid-3">
              <div class="text-block-11">What do you need help with?</div>
              <div class="text-block-11">Project Budget</div>
            </div>
            <div class="w-layout-grid grid-2">
              <div id="w-node-f99b3f3e-f4d3-b005-9499-ac2fde9559c7-de9559b7" class="div-block-58">
                <label class="w-checkbox checkbox-field">
                  <input id="UX-UI-Design-2" type="checkbox" name="UX-UI-Design-2" class="w-checkbox-input checkbox" />
                  <span class="checkbox-label-2 w-form-label" for="UX-UI-Design-2">UX/UI Design</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="Website-2" type="checkbox" name="Website-2" class="w-checkbox-input checkbox-2" />
                  <span class="checkbox-label-3 w-form-label" for="Website-2">Website</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="App-2" type="checkbox" name="App-2" class="w-checkbox-input checkbox-3" />
                  <span class="checkbox-label-4 w-form-label" for="App-2">App</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="Product-Strategy-2" type="checkbox" name="Product-Strategy-2" class="w-checkbox-input checkbox-4" />
                  <span class="checkbox-label-5 w-form-label" for="Product-Strategy-2">Product Strategy</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="Other-2" type="checkbox" name="Other-2" class="w-checkbox-input checkbox-5" />
                  <span class="checkbox-label w-form-label" for="Other-2">Other</span>
                </label>
              </div>
              <div id="w-node-f99b3f3e-f4d3-b005-9499-ac2fde9559dc-de9559b7" class="div-block-59">
                <label class="w-checkbox checkbox-field">
                  <input id="5-25K-2" type="checkbox" name="5-25K-2" class="w-checkbox-input checkbox-6" />
                  <span class="checkbox-label-2 w-form-label" for="5-25K-2">5-25K</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="25-50K-2" type="checkbox" name="25-50K-2" class="w-checkbox-input checkbox-7" />
                  <span class="checkbox-label-6 w-form-label" for="25-50K-2">25-50K</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="50-100K-2" type="checkbox" name="50-100K-2" class="w-checkbox-input checkbox-8" />
                  <span class="checkbox-label-7 w-form-label" for="50-100K-2">50-100K</span>
                </label>
                <label class="w-checkbox checkbox-field">
                  <input id="100K-2" type="checkbox" name="100K-2" class="w-checkbox-input checkbox-9" />
                  <span class="checkbox-label-8 w-form-label" for="100K-2">100K+</span>
                </label>
              </div>
            </div>
            <div class="w-layout-grid grid-4">
              <div id="w-node-f99b3f3e-f4d3-b005-9499-ac2fde9559ee-de9559b7">
                <label for="name-2" class="field-label">Name</label>
                <input class="name-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="Your Name" type="text" id="name-2" required />
              </div>
              <div id="w-node-f99b3f3e-f4d3-b005-9499-ac2fde9559f2-de9559b7">
                <label for="email-2" class="field-label-2">Email</label>
                <input class="email-field w-input" maxlength="256" name="email-2" data-name="Email 2" placeholder="name@company.com" type="email" id="email-2" required />
              </div>
            </div>
            <label for="Message-3" class="field-label-2">Message</label>
            <textarea placeholder="Write your message here" maxlength="5000" id="Message-3" name="Message" data-name="Message" class="textarea w-input"></textarea>
            <input type="submit" data-wait="Please wait..." data-w-id="f99b3f3e-f4d3-b005-9499-ac2fde9559f9" class="submit-button w-button" value="Send" />
          </form>
          <div class="success-message w-form-done" id="form-success">
            <div class="div-block-60">
              <img src={`${CDN}/63d920cf12dea33d3c020029_seed.svg`} loading="lazy" alt="seeds growing" class="image-29" />
            </div>
            <div class="text-block-33">Thank you! You have just planted the first seeds of your product.</div>
          </div>
          <div class="error-message w-form-fail" id="form-error">
            <div class="text-block-34">Oops! Something went wrong while submitting the form.</div>
          </div>
        </div>
      </div>
      <div class="let-s-work">
        <div class="div-block-9">
          <div class="text-block-12">Let's work together</div>
          <img src={`${CDN}/63c8e81fec00412b08a96e9a_lets%20work.svg`} loading="lazy" alt="" class="image-7" />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('email-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const success = document.getElementById('form-success');
    const error = document.getElementById('form-error');
    const form = e.target;
    if (success && error && form) {
      success.style.display = 'block';
      error.style.display = 'none';
      (form as HTMLFormElement).style.display = 'none';
      (form as HTMLFormElement).reset();
    }
  });
</script>
